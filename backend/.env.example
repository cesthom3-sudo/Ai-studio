# Copy this file to .env and fill in real values. Never commit .env.

# Backend
BACKEND_URL=https://your-backend-url.com
PORT=8000
STORAGE_DIR=./storage

# --- AI provider keys (leave blank to run in DEMO MODE) ---

# Text generation (e.g. an LLM provider)
TEXT_PROVIDER=demo
TEXT_API_KEY=

# Image generation / editing
IMAGE_PROVIDER=demo
IMAGE_API_KEY=

# Video generation / image-to-video
VIDEO_PROVIDER=demo
VIDEO_API_KEY=

# Text-to-speech
TTS_PROVIDER=demo
TTS_API_KEY=

# Sound effects / background audio
AUDIO_PROVIDER=demo
AUDIO_API_KEY=
